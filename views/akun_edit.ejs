<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Profil</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
  <nav>
    <span class="brand"><span class="logo-mark"><i class="fa-solid fa-briefcase"></i></span>FreelanceKu</span>
    <div>
      <%- include('partials/theme-toggle') %>
      <%- include('partials/bell') %>
      <a href="/akun">Kembali</a>
    </div>
  </nav>
  <div class="container with-tabbar">
    <h2>Edit Profil</h2>

    <div class="card">
      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <div style="text-align:center; margin-bottom:14px">
        <% if (profile.foto_url) { %>
          <img src="<%= profile.foto_url %>" alt="Foto profil" class="profile-photo-preview" onerror="this.style.display='none'">
        <% } else { %>
          <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary-light));color:#fff;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;margin:0 auto"><%= profile.name.charAt(0).toUpperCase() %></div>
        <% } %>
      </div>

      <form method="POST" action="/akun/edit">
        <label>Nama</label>
        <input type="text" name="name" value="<%= profile.name %>" required>

        <label>Nomor HP</label>
        <input type="tel" name="phone" value="<%= profile.phone || '' %>" required>

        <label>Link Foto Profil (opsional)</label>
        <input type="url" name="foto_url" value="<%= profile.foto_url || '' %>" placeholder="https://...">
        <p class="muted" style="margin-top:4px">Tempel link gambar (mis. dari Google Drive/Imgur yang bisa diakses publik).</p>

        <label>Bio Singkat (opsional)</label>
        <textarea name="bio" maxlength="150" placeholder="Ceritakan sedikit tentang kamu (maks. 150 karakter)"><%= profile.bio || '' %></textarea>

        <% if (profile.email) { %>
          <label>Email</label>
          <input type="email" value="<%= profile.email %>" disabled>
          <p class="muted" style="margin-top:4px">Email tidak bisa diubah sendiri, hubungi admin kalau perlu diganti.</p>
        <% } %>

        <button type="submit" style="margin-top:10px">Simpan Perubahan</button>
      </form>
    </div>
  </div>
  <%- include('partials/tabbar', { active: 'akun' }) %>
</body>
</html>
