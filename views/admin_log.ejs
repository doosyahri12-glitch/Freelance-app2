<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Log Aktivitas</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
  <%- include('partials/admin-nav', { active: 'log' }) %>
  <div class="container">
    <h2>Log Aktivitas Admin</h2>
    <p class="muted">Menampilkan 200 aktivitas terbaru.</p>

    <% if (logs.length === 0) { %>
      <div class="empty-state"><%- include('partials/illustration-empty') %><p>Belum ada aktivitas tercatat.</p></div>
    <% } %>

    <% logs.forEach(l => { %>
      <div class="card">
        <p style="margin:0"><%= l.action %></p>
        <p class="muted" style="margin:4px 0 0">oleh <%= l.admin_name || '-' %> &middot; <%= l.created_at %></p>
      </div>
    <% }) %>
  </div>
</body>
</html>
