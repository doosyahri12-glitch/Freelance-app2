<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Semua Pekerjaan (Admin)</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <span class="brand">FreelanceKu &middot; Admin</span>
    <div>
      <a href="/admin">Dashboard</a>
      <a href="/admin/users">User</a>
      <a href="/admin/tasks">Tugas</a>
      <a href="/admin/jobs" class="active">Pekerjaan</a>
      <a href="/logout">Logout</a>
    </div>
  </nav>
  <div class="container">
    <h2>Semua Pekerjaan</h2>
    <a href="/admin/jobs/new" class="btn">+ Posting Pekerjaan Baru</a>

    <% jobs.forEach(job => { %>
      <div class="card">
        <h3><a href="/jobs/<%= job.id %>"><%= job.title %></a></h3>
        <span class="badge <%= job.status %>"><%= job.status === 'open' ? 'Terbuka' : 'Ditutup' %></span>
        <p class="muted">Oleh <%= job.client_name %> &middot; <%= job.category || 'Umum' %></p>
        <p>Rp <%= job.budget.toLocaleString('id-ID') %></p>
      </div>
    <% }) %>
  </div>
</body>
</html>
